# ==============================================================================
# KAVERI MEMBER CLUB • ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to '.env' and fill in real production secrets before deployment.
# NEVER commit real .env files with passwords or tokens to version control.
# ==============================================================================

# Application Environment (development | production | test)
ENV=production
DEBUG=false
APP_NAME="Kaveri Member Club"

# Security & Authentication
# Generate a 32+ character random secret using: openssl rand -hex 32
SECRET_KEY=change_me_to_a_cryptographically_secure_random_key_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=720
SESSION_COOKIE_NAME=kaveri_session
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Database Configuration (PostgreSQL in production / Docker)
# For local SQLite development: sqlite+aiosqlite:///./kaveri.db
DATABASE_URL=postgresql+asyncpg://kaveri_admin:change_me_in_production_password@localhost:5432/kaveri_db
POSTGRES_DB=kaveri_db
POSTGRES_USER=kaveri_admin
POSTGRES_PASSWORD=change_me_in_production_password

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTRATION_PER_MINUTE=15

# Business Identity & Store Contact
BUSINESS_NAME="Kaveri Electronic Halaguru"
BUSINESS_ADDRESS="HMS Complex, Kanakapura Main Road, Halaguru Hobli, Karnataka - 571421, India"
BUSINESS_PHONE="+91 94481 23456"
BUSINESS_EMAIL="support@kaverielectronics.in"
BUSINESS_WHATSAPP_GROUP_URL="https://chat.whatsapp.com/KaveriClubOfficial"
MEMBER_ID_PREFIX="KAV-"
DPDP_NOTICE_VERSION="v1.0_2026_DPDP"
REGISTRATION_BONUS_POINTS=50

# Meta WhatsApp Business Cloud API (Optional - safe dry-run mode if unset)
# Register at: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=EAAB...your_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000000
WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate_random_webhook_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Indian Telecom TRAI DLT SMS Gateway (Optional - safe dry-run mode if unset)
# Register at Vilpower / Airtel / Jio DLT portal for Entity ID and Header
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_API_KEY=your_dlt_sms_api_key_here
SMS_SENDER_ID=KAVERI
SMS_ENTITY_ID=1201000000000000000
